# ─── Supabase ──────────────────────────────────────────────────────────────
# Public (safe to expose to the browser — used by @supabase/ssr)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never import in a client component.
# Bypasses RLS entirely. Anyone who has this can read/write every table.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ───────────────────────────────────────────────────────────────────
# Canonical origin used in OAuth redirect URLs and email links.
# In production: https://your-domain.com
# In preview: the auto-assigned https://vam-*-git-*.vercel.app domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Groq ──────────────────────────────────────────────────────────────────
# One API key covers all four models. Create at https://console.groq.com/.
# Model ids are versioned — pin to the current "production" model ids at
# the time of deployment. See https://console.groq.com/docs/models.
GROQ_API_KEY=
GROQ_MODEL_CHAT=llama-3.3-70b-versatile
GROQ_MODEL_UTILITY=llama-3.1-8b-instant
GROQ_MODEL_STT=whisper-large-v3-turbo
GROQ_MODEL_TTS=playai-tts

# ─── Cron / internal routes ────────────────────────────────────────────────
# Long random value (>= 32 bytes) used by the scheduled irreversible
# account-purge route. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the SAME value in Vercel env vars (this file) AND in Vercel cron
# header config (see SETUP.md step 5).
INTERNAL_CRON_SECRET=replace-with-32-byte-random-hex

# ─── Sentry (optional) ─────────────────────────────────────────────────────
# Leave empty to disable error tracking. Get a DSN from sentry.io.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Optional: only needed in CI/production to upload readable source maps
# (see next.config.mjs). Leave all three empty locally — the build works
# fine without them, it just uploads minified stack traces to Sentry.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
