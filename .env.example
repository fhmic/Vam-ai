# ─── Supabase ──────────────────────────────────────────────────────────────
# Public (safe to expose to the browser — used by @supabase/ssr)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never import in a client component.
# Bypasses RLS entirely. Anyone who has this can read/write every table.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ───────────────────────────────────────────────────────────────────
# Canonical origin used in OAuth redirect URLs and email links.
# In production: https://your-domain.com
# In preview: the auto-assigned https://vam-*-git-*.vercel.app domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Gemini ────────────────────────────────────────────────────────────────
# One API key covers all four models. Create at https://aistudio.google.com/apikey.
# Model ids are versioned and Google deprecates on a published schedule —
# pin to current, non-deprecated model ids at deployment time. See
# https://ai.google.dev/gemini-api/docs/models and
# https://ai.google.dev/gemini-api/docs/deprecations (the Gemini 2.5 family,
# including its TTS preview models, is scheduled to shut down 16 Oct 2026 —
# don't deploy against it after that date).
#
# GEMINI_MODEL_STT does not need to be a distinct model — Gemini has no
# dedicated transcription endpoint, transcription is just a generateContent
# call with an audio input part, so any current multimodal Gemini model
# works. Pointing it at the same model as GEMINI_MODEL_UTILITY is fine.
GEMINI_API_KEY=
GEMINI_MODEL_CHAT=gemini-3.5-flash
GEMINI_MODEL_UTILITY=gemini-3.1-flash-lite
GEMINI_MODEL_STT=gemini-3.1-flash-lite
GEMINI_MODEL_TTS=gemini-3.1-flash-tts-preview

# ─── Cron / internal routes ────────────────────────────────────────────────
# Long random value (>= 32 bytes) used by the scheduled irreversible
# account-purge route. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the SAME value in Vercel env vars (this file) AND in Vercel cron
# header config (see SETUP.md step 5).
INTERNAL_CRON_SECRET=replace-with-32-byte-random-hex

# ─── Sentry (optional) ─────────────────────────────────────────────────────
# Leave empty to disable error tracking. Get a DSN from sentry.io.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Optional: only needed in CI/production to upload readable source maps
# (see next.config.mjs). Leave all three empty locally — the build works
# fine without them, it just uploads minified stack traces to Sentry.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
